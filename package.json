{
  "name": "@harbor-community/scrypted-harbor",
  "version": "0.1.8",
  "description": "Multi-camera Harbor WHIP bridge for Scrypted and HomeKit",
  "author": "Community project",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/Harbor-Systems/harbor-scrypted-public#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Harbor-Systems/harbor-scrypted-public.git"
  },
  "bugs": {
    "url": "https://github.com/Harbor-Systems/harbor-scrypted-public/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "scrypted-setup-project": "scrypted-setup-project",
    "prescrypted-setup-project": "scrypted-package-json",
    "build": "scrypted-webpack",
    "postbuild": "node scripts/smoke-scrypted-runtime.cjs",
    "prepublishOnly": "NODE_ENV=production scrypted-webpack",
    "scrypted-deploy": "scrypted-deploy",
    "scrypted-deploy-debug": "scrypted-deploy-debug",
    "scrypted-vscode-launch": "scrypted-deploy-debug",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "npm run test && npm run typecheck && npm run build"
  },
  "keywords": [
    "scrypted",
    "plugin",
    "harbor",
    "camera",
    "whip",
    "webrtc",
    "homekit"
  ],
  "scrypted": {
    "name": "Harbor Camera Bridge",
    "type": "DeviceProvider",
    "interfaces": [
      "ScryptedSystemDevice",
      "ScryptedDeviceCreator",
      "DeviceProvider",
      "DeviceCreator",
      "Settings",
      "HttpRequestHandler"
    ],
    "pluginDependencies": [
      "@scrypted/prebuffer-mixin",
      "@scrypted/snapshot"
    ]
  },
  "dependencies": {
    "@scrypted/sdk": "0.5.59"
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "terser-webpack-plugin": "^5.6.1"
  }
}
